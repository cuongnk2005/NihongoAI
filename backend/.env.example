# AI Provider: gemini | freellmapi | mock
AI_PROVIDER=gemini

# Google Gemini Configuration
# Có thể dùng 1 key đơn hoặc danh sách nhiều key cách nhau bằng dấu phẩy
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
GEMINI_MODEL=gemini-3.5-flash-lite

# FreeLLMAPI / OpenAI-compatible Configuration (Optional)
# FREELLMAPI_BASE_URL=http://localhost:3001/v1
# FREELLMAPI_API_KEY=your_freellmapi_unified_key_here
# FREELLMAPI_MODEL=gemini-2.0-flash
